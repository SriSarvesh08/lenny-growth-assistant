# LLM Provider Configuration
AGENT_PROVIDER=local # Options: local, cloud
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL= # Leave blank for default Anthropic API, or set to proxy URL

# Local Ollama Configuration (Default for Demo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b
OLLAMA_FALLBACK_MODEL=qwen2.5-coder:1.5b
LITELLM_PROXY_PORT=4000

# Embedding Configuration
EMBEDDING_PROVIDER=fake # Options: fake, local
EMBEDDING_MODEL_NAME=nomic-embed-text
EMBEDDING_DIMENSION=768

# PostgreSQL / pgvector Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_assistant
POSTGRES_HOST=localhost # Use 'postgres' when running in docker-compose
POSTGRES_PORT=5433
